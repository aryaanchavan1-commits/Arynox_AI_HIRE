# ARYNOX AI HIRE - Environment Configuration
# Copy this to .env and fill in your values

# Mode: "local" (demo user + relaxed auth) or "production" (JWT auth required)
# Note: mock providers are chosen automatically per-service when their key is absent.
APP_MODE=local
PORT=8000

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM Provider ---
# Options: "groq" (auto-falls back to mock without a key)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Voice (STT + TTS) ---
# Sarvam AI powers both speech-to-text and text-to-speech (English, Hindi, Marathi)
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
SARVAM_API_KEY=
# Legacy aliases (still read if SARVAM_API_KEY is unset)
STT_API_KEY=
TTS_API_KEY=

# --- Avatar ---
# Options: "external" (Tavus/D-ID), "local" (3D), "mock"
AVATAR_PROVIDER=local
TAVUS_API_KEY=
TAVUS_DEFAULT_FACE_ID=
DID_API_KEY=

# --- LiveKit (Realtime Transport) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Database ---
# Neon PostgreSQL connection string
# 1. Go to https://neon.tech and create a free account
# 2. Create a new project (any name)
# 3. Copy the connection string from the Dashboard > Connection Details
# 4. Paste it below (with ?sslmode=require at the end)
DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Auth ---
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-this-in-production

# --- Supabase (optional, used by the Node server variant) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional integrations ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
