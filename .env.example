# ARYNOX AI HIRE - Environment Configuration
# Copy this to .env and fill in your values

# Mode: "local" (mock providers) or "production" (real providers)
APP_MODE=local
PORT=8000

# Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LLM Provider ---
# Options: "groq", "openai", "anthropic", "mock" (auto-selected in local mode)
LLM_PROVIDER=groq
GROQ_API_KEY=

# --- Speech-to-Text ---
# Options: "sarvam", "mock" (auto-selected in local mode)
STT_PROVIDER=sarvam
SARVAM_API_KEY=

# --- Text-to-Speech ---
# Options: "sarvam", "mock" (auto-selected in local mode)
TTS_PROVIDER=sarvam

# --- Avatar ---
# Options: "external" (Tavus/D-ID), "local" (3D), "mock"
AVATAR_PROVIDER=local
TAVUS_API_KEY=
TAVUS_DEFAULT_FACE_ID=
DID_API_KEY=

# --- LiveKit (Realtime Transport) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Database ---
DATABASE_URL=

# --- Auth ---
JWT_SECRET=change-this-in-production

# --- Supabase (optional) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
